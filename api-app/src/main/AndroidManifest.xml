<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The embedded API serves HTTPS over the LAN and discovers/advertises
         itself over mDNS; it runs as a long-lived foreground service. -->
    <!-- Signature-level permission guarding ApiKeyProvider. Only an app signed
         with the same certificate (the genuine Lava client) can read the
         provider — third-party apps are denied at the OS level. §5 of the
         design spec; §6.H credential security. -->
    <permission
        android:name="digital.vasic.lava.permission.READ_API_KEY"
        android:protectionLevel="signature" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- specialUse FGS: the embed is a long-lived LAN API server with no
         cumulative runtime budget. dataSync (the prior type) is capped at
         ~6h/24h on Android 14+ and CRASHED the service (ForegroundServiceStart-
         NotAllowedException) once exhausted. See
         docs/issues/2026-06-14-apiapp-fgs-datasync-budget-fix-design.md. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Package visibility (Android 11+ / API 30): declare the Lava client
         packages so getLaunchIntentForPackage returns non-null for them, and
         declare market:// + https:// so the Play Store store-redirect works.
         Without these <queries> entries, getLaunchIntentForPackage returns null
         on API 30+ even when the app IS installed — a silent false-not-installed
         bluff the <queries> block prevents. -->
    <queries>
        <package android:name="digital.vasic.lava.client" />
        <package android:name="digital.vasic.lava.client.dev" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".ApiApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/api_app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LavaApi"
        android:usesCleartextTraffic="true"
        tools:targetApi="TIRAMISU">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/api_app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- foregroundServiceType=specialUse: the embed continuously serves LAN
             API requests + advertises over mDNS. This is a long-lived server
             that does NOT fit any of the standard typed categories, and it must
             run far longer than the dataSync 6h/24h budget. The
             PROPERTY_SPECIAL_USE_FGS_SUBTYPE value is the free-form Google Play
             Console review justification. -->
        <service
            android:name=".service.ApiEngineService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="@string/api_fgs_special_use_justification" />
        </service>

        <!-- Key provider: exposes {access_key, loopback_port} to the Lava
             client app via a signature-permission ContentProvider (spec §5).
             The authority is variant-aware via the apiKeyAuthority placeholder
             set in build.gradle.kts per build type. android:exported="true" is
             required so the client process (a different UID) can query it;
             android:readPermission restricts access to same-certificate signers. -->
        <provider
            android:name=".handoff.ApiKeyProvider"
            android:authorities="${apiKeyAuthority}"
            android:exported="true"
            android:readPermission="digital.vasic.lava.permission.READ_API_KEY" />
    </application>
</manifest>
