# Lava — local environment configuration template.
# Copy to `.env` and replace placeholders with real values. The `.env`
# file is gitignored (constitutional 6.H Credential Security).
#
# IMPORTANT: NEVER commit a real .env. The placeholders below are safe;
# the real values are sensitive and live only on developer machines.

# ============================================================
# Signing
# ============================================================
# Signing keystore password (used for both debug and release).
KEYSTORE_PASSWORD=your_password_here

# Directory containing the signing keystores (relative to project root).
KEYSTORE_ROOT_DIR=keystores

# ============================================================
# Tracker credentials (provider login Challenge Tests + manual smoke)
# ============================================================
# These are used by `app/build.gradle.kts` to populate BuildConfig
# fields read by the Challenge Tests at C2 and the dev-mode auto-fill.
RUTRACKER_USERNAME=your_rutracker_login
RUTRACKER_PASSWORD=your_rutracker_password
KINOZAL_USERNAME=your_kinozal_login
KINOZAL_PASSWORD=your_kinozal_password
NNMCLUB_USERNAME=your_nnmclub_login
NNMCLUB_PASSWORD=your_nnmclub_password
RUTOR_USERNAME=your_rutor_login
RUTOR_PASSWORD=your_rutor_password
IPTORRENTS_USERNAME=your_iptorrents_login
IPTORRENTS_PASSWORD=your_iptorrents_password

# ============================================================
# Jackett Torznab sidecar (optional; lava-api-go server-side — NOT the app)
# Off by default. When enabled, lava-api-go exposes the Jackett-backed search
# route and proxies the Jackett sidecar (api_key lives in Jackett's /config
# volume — §6.H secret, never sent to the device).
# FlareSolverr is required for Cloudflare-protected trackers (e.g. IPTorrents).
#
# Deployed via tools/lava-containers/docker-compose.jackett.yml (profiles
# `jackett` and `cloudflare`). Validate end-to-end with
# scripts/validate-jackett-sidecar.sh.
# ============================================================
# --- lava-api-go consumer knobs (read by internal/config/config.go) ---------
LAVA_API_JACKETT_ENABLED=false
# IMPORTANT: lava-api-go runs network_mode: host, so it CANNOT resolve the
# bridge DNS name `lava-jackett`. The Jackett port is published to the host
# loopback by the compose fragment, so the URL is 127.0.0.1, not a bridge name.
LAVA_API_JACKETT_URL=http://127.0.0.1:9117
# Jackett generates this on first run into its /config/ServerConfig.json. Copy
# it here (or let the Containers glue populate it). Drives BOTH the Go service
# AND the container healthcheck — there is no second name to keep in sync.
LAVA_API_JACKETT_APIKEY=your_jackett_api_key
LAVA_API_JACKETT_DEFAULT_INDEXER=all

# --- Container / image knobs (read by docker-compose.jackett.yml) -----------
# Pin BOTH images by digest in your real .env for reproducibility (§6.K).
LAVA_JACKETT_IMAGE=lscr.io/linuxserver/jackett:latest
LAVA_FLARESOLVERR_IMAGE=ghcr.io/flaresolverr/flaresolverr:latest
# Host-side loopback publish (NOT the LAN). Move the port if 9117/8191 is taken.
LAVA_JACKETT_BIND_HOST=127.0.0.1
LAVA_JACKETT_HOST_PORT=9117
LAVA_FLARESOLVERR_BIND_HOST=127.0.0.1
LAVA_FLARESOLVERR_HOST_PORT=8191
# Gitignored host volume for Jackett's /config (api_key + per-indexer creds).
# This path is a §6.H secrets store — keep it out of git (see .gitignore).
LAVA_JACKETT_CONFIG_DIR=./.jackett-config
# LinuxServer image user/group/timezone.
LAVA_JACKETT_PUID=1000
LAVA_JACKETT_PGID=1000
LAVA_JACKETT_TZ=Etc/UTC
# FlareSolverr verbosity (info|debug).
LAVA_FLARESOLVERR_LOG_LEVEL=info

# ============================================================
# Firebase — for Crashlytics, Analytics, Performance, App Distribution
# ============================================================
# Firebase CLI token. Obtain via `firebase login:ci` (one-time, then store
# the printed token here). NEVER commit this value.
LAVA_FIREBASE_TOKEN=1//your-firebase-ci-token-goes-here

# Firebase project + app IDs. Get from Firebase Console → Project Settings
# → General after `firebase apps:create` runs.
LAVA_FIREBASE_PROJECT_ID=your-firebase-project-id
LAVA_FIREBASE_ANDROID_APP_ID=1:000000000000:android:0000000000000000000000
LAVA_FIREBASE_ANDROID_DEV_APP_ID=1:000000000000:android:0000000000000000000000
LAVA_FIREBASE_API_GO_APP_ID=1:000000000000:web:0000000000000000000000

# Firebase app-ids for the on-device API server app (:api-app,
# digital.vasic.lava.api). Obtain after creating the apps in the Console:
#   firebase apps:create ANDROID "Lava API (release)" \
#     --package-name digital.vasic.lava.api \
#     --project $LAVA_FIREBASE_PROJECT_ID
#   firebase apps:create ANDROID "Lava API (debug)" \
#     --package-name digital.vasic.lava.api.dev \
#     --project $LAVA_FIREBASE_PROJECT_ID
# These are validated lazily by firebase-distribute.sh when --app api-app
# is chosen; they are NOT required for the default client-only distribute flow.
LAVA_FIREBASE_API_APP_ID=1:000000000000:android:0000000000000000000000
LAVA_FIREBASE_API_APP_DEV_APP_ID=1:000000000000:android:0000000000000000000000

# App Distribution tester roster. The list is loaded from .env at distribute
# time (see scripts/firebase-distribute.sh). Three roles by convention:
#   OWNER     — release manager / org owner
#   DEVELOPER — agent or human developer authoring the build
#   TESTER    — external QA tester
LAVA_FIREBASE_TESTERS_OWNER=owner@example.com
LAVA_FIREBASE_TESTERS_DEVELOPER=developer@example.com
LAVA_FIREBASE_TESTERS_TESTER=tester@example.com

# ============================================================
# Remote Go API distribution — for thinker.local + future hosts
# ============================================================
# scripts/distribute-api-remote.sh ships the lava-api-go OCI image
# tarball + boot script + TLS material to a remote host via SSH and
# brings the stack up under rootless Podman. The remote host MUST:
#   - be reachable at $LAVA_REMOTE_HOST_USER@$LAVA_API_GO_REMOTE_HOST
#   - have passwordless SSH (key-based auth) configured
#   - have rootless Podman 4.x or later installed
#
# Defaults match the operator's primary remote (thinker.local). Override
# either variable in your local .env to target a different host. Multi-
# host fan-out (matching the HelixAgent / Catalogizer pattern) is owed
# in a follow-up phase; for now one remote per distribute invocation.
LAVA_API_GO_REMOTE_HOST=thinker.local
LAVA_REMOTE_HOST_USER=milosvasic

# Default Cloud / remote-server API option shown on the onboarding
# "Choose your API" screen (2026-05-31). Placeholder until a real public
# Lava-API origin exists. Format: https://host:port (comma-separate for
# multiple). Parsed into Endpoint.GoApi(host, port). Blank → manual-entry
# field only, no preset. §6.R: the ONLY place the lava.app:7777 placeholder lives.
LAVA_DEFAULT_CLOUD_API=https://lava.app:7777

# Sub-project 2 (on-device API): where the Settings "Run the API on this
# device" row sends the user to install the separate Lava API app
# (digital.vasic.lava.api) when it is not already installed. Placeholder docs
# URL until Sub-project 4 wires the real Firebase App Distribution link.
# §6.R: the download URL lives here, never as a source literal.
LAVA_API_APP_DOWNLOAD_URL=https://lava.app/download/api-app
# Firebase App Distribution (or equivalent) download page for the Lava client
# app, used by api-app's SiblingAppLauncher when the client is not installed.
# §6.R: never a source literal — lives here only.
LAVA_CLIENT_APP_DOWNLOAD_URL=https://lava.app/download/client

# === Phase 1 (2026-05-06): API auth + transport ===

# Auth field identifier (read by both API + Android build)
LAVA_AUTH_FIELD_NAME=Lava-Auth

# Allowlist + rotation
LAVA_AUTH_CURRENT_CLIENT_NAME=android-1.2.7-1027
LAVA_AUTH_ACTIVE_CLIENTS=android-1.2.7-1027:00000000-0000-0000-0000-000000000000
LAVA_AUTH_RETIRED_CLIENTS=

# API-only
LAVA_AUTH_HMAC_SECRET=cGxhY2Vob2xkZXItcmVwbGFjZS1tZS1pbi1lbnYtZmlsZQ==
LAVA_AUTH_BACKOFF_STEPS=2s,5s,10s,30s,1m,1h
LAVA_AUTH_TRUSTED_PROXIES=
LAVA_AUTH_MIN_SUPPORTED_VERSION_NAME=1.2.6
LAVA_AUTH_MIN_SUPPORTED_VERSION_CODE=1026

# Android-build-only
LAVA_AUTH_OBFUSCATION_PEPPER=cGxhY2Vob2xkZXItcmVwbGFjZS1tZS1pbi1lbnYtZmlsZQ==

# Storage backend (API runtime)
# Selects the persistence backend for the response cache + audit tables.
#   postgres (default) — requires LAVA_API_PG_URL (existing behavior, unchanged).
#   sqlite             — pure-Go modernc.org/sqlite; requires LAVA_API_SQLITE_PATH
#                        and does NOT require Postgres. Intended for single-node /
#                        embedded deployments where running Postgres is overkill.
LAVA_API_STORAGE_BACKEND=postgres
LAVA_API_SQLITE_PATH=/data/lava-api.db

# Transport (API runtime)
LAVA_API_HTTP3_ENABLED=true
LAVA_API_BROTLI_QUALITY=4
LAVA_API_BROTLI_RESPONSE_ENABLED=true
LAVA_API_BROTLI_REQUEST_DECODE_ENABLED=false
LAVA_API_PROTOCOL_METRIC_ENABLED=true

# ============================================================
# DEV API instance (issue 3/3, 2026-05-14)
# ============================================================
# A side-by-side lava-api-go process for developer iteration. Advertises
# `_lava-api-dev._tcp` so only the .dev-suffixed Android debug build
# discovers it (release builds ignore the dev service type entirely).
# Bring up via `docker compose -f docker-compose.dev.yml up`.
#
# Defaults are sane; override here only if you need to avoid a port
# collision with another local service.
LAVA_API_DEV_LISTEN=:8543
LAVA_API_DEV_METRICS_LISTEN=:9092
LAVA_API_DEV_MDNS_PORT=8543
LAVA_API_DEV_MDNS_INSTANCE=Lava API (dev)

# ============================================================
# Code quality / security scanning (completeness program, 2026-06-04)
# ============================================================
# SonarQube auth token for scripts/sonar-scan.sh. Generate it in the LOCAL
# Sonar UI after `scripts/sonar-scan.sh up`: http://127.0.0.1:9000 →
# My Account → Security → Generate Tokens. NEVER commit the real value (§6.H).
SONAR_TOKEN=

# Optional overrides for the dedicated Sonar Postgres (docker-compose.sonar.yml).
# Defaults are fine for local use; override only to avoid collisions.
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=sonar
SONAR_DB_NAME=sonar

# Snyk auth token for scripts/snyk-scan.sh. Obtain from
# https://app.snyk.io/account (Auth Token). The script EXITS (no fake pass) if
# this is unset; interactive `snyk auth` is intentionally not used (§6.R/§6.U).
SNYK_TOKEN=
