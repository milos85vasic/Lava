# Lava — distributed deployment config for nezha.local
#
# Target host: nezha.local
#   - SSH: passwordless, key-based authentication, user=milosvasic
#   - Runtime: rootless Podman 5.7.1 + podman-compose 1.5.0 (crun)
#   - Hardware: i7 (8 logical CPUs), 64 GB RAM, NVMe (~388 GB free), /dev/kvm live
#   - Role: DEDICATED heavy-testing node (real production services) + KVM
#           containerized Android emulator matrix host (per §6.X / §6.AH).
#           thinker.local remains the API-distribute default; nezha is ADDED.
#
# Usage:
#   ./scripts/distribute-api-remote.sh nezha.local
#   ssh nezha.local bash -s < deployment/nezha/nezha-up.sh      # (Phase 3)
#
# Constitutional bindings:
#   §6.H Credential Security — NO real secrets in this committed file. Real
#         tracker creds / HMAC secret / Firebase token are appended at
#         distribute time from the operator's gitignored local .env. The
#         Postgres password below is a non-production TEST default.
#   §6.J Anti-Bluff — boot scripts that consume this gate on real /health.
#   §6.M Host-Stability — rootless Podman; no host power-management.
#   §6.R No-Hardcoding — ports/hosts live HERE (the config source), never
#         as literals in tracked source code.

# ---- Networks ----
LAVA_NEZHA_NETWORK=lava-nezha
LAVA_NEZHA_NETWORK_DEV=lava-nezha-dev

# ---- PROD API stack ports (LAN-reachable; Android devices discover via mDNS) ----
LAVA_NEZHA_API_PORT=8443
LAVA_NEZHA_POSTGRES_PORT=8432
LAVA_NEZHA_METRICS_PORT=9091

# ---- DEV API stack ports (distinct, side-by-side with prod) ----
LAVA_NEZHA_API_DEV_PORT=8543
LAVA_NEZHA_POSTGRES_DEV_PORT=8433
LAVA_NEZHA_METRICS_DEV_PORT=9092

# ---- Container names (distinct from thinker + local names) ----
LAVA_NEZHA_API_NAME=lava-api-go-nezha
LAVA_NEZHA_POSTGRES_NAME=lava-postgres-nezha
LAVA_NEZHA_API_DEV_NAME=lava-api-go-nezha-dev
LAVA_NEZHA_POSTGRES_DEV_NAME=lava-postgres-nezha-dev

# ---- Resource budgets (nezha has 64 GB; generous but bounded per §6.T.2) ----
LAVA_NEZHA_API_CPUS=4
LAVA_NEZHA_API_MEMORY=4g
LAVA_NEZHA_POSTGRES_CPUS=2
LAVA_NEZHA_POSTGRES_MEMORY=2g

# ---- Postgres credentials (NON-secret TEST default; isolated DB) ----
LAVA_NEZHA_POSTGRES_USER=lava
LAVA_NEZHA_POSTGRES_PASSWORD=lava-nezha-test-default
LAVA_NEZHA_POSTGRES_DB=lava

# ---- Remote paths ----
LAVA_NEZHA_REMOTE_DIR=/home/milosvasic/lava
LAVA_NEZHA_IMAGE_TAR=/tmp/lava-api-go-nezha.image.tar
LAVA_NEZHA_TLS_CERT=/home/milosvasic/lava/tls/server.crt
LAVA_NEZHA_TLS_KEY=/home/milosvasic/lava/tls/server.key

# ---- Observability stack (standard public images; pulled directly) ----
# NOTE: nezha is a SHARED host (also runs llmsverifier, boba). Prometheus host
# port moved 9090 -> 9190 because llmsverifier_prometheus_1 holds :9090
# (co-tenant port-collision discovered 2026-06-16). Container-internal port
# stays 9090; only the host publish differs.
LAVA_NEZHA_OBSERVABILITY_ENABLED=true
LAVA_NEZHA_PROMETHEUS_PORT=9190
LAVA_NEZHA_LOKI_PORT=3100

# ---- Cloudflare mitigation (only required for IPTorrents; RuTracker/RuTor/
#      NNMClub/native providers do NOT need it) ----
# Jackett host port moved 9117 -> 9217 (boba-jackett holds :9117 on this shared
# host). Container-internal port stays 9117.
LAVA_NEZHA_CF_MITIGATION_ENABLED=true
LAVA_NEZHA_JACKETT_PORT=9217
LAVA_NEZHA_FLARESOLVERR_PORT=8191

# ---- KVM Android emulator matrix (per §6.X/§6.AH; containers submodule) ----
LAVA_NEZHA_EMULATOR_RUNNER=containerized
LAVA_NEZHA_EMULATOR_KVM=true
