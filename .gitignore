*.iml
.gradle
/local.properties
/.idea
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties
.kotlin/
.env
keystores/
.claude/
releases/
tools/lava-containers/bin/

# Jackett sidecar /config volume — §6.H secrets store (api_key + per-indexer
# credentials, generated on first run). NEVER committed. Default location per
# LAVA_JACKETT_CONFIG_DIR in .env.example; the glob covers relocations too.
.jackett-config/
**/.jackett-config/

# Hardlinked .git mirrors created before destructive operations
# (HelixConstitution §9 absolute-data-safety). Per §6.AD: never tracked,
# always recreated on demand, retention is operator's choice.
.git-backup-*/

# §11.4.24 build-stats per-sample tempfiles (registry.tsv IS tracked).
.lava-ci-evidence/build-stats/.sample-*
.lava-ci-evidence/build-stats/.meta-*

# Local tool configuration and state
.kimi/
.specify/
KIMI.md

# Pre-push hook multi-mirror dedup cache (advisory; recreated on demand).
# Forensic anchor: SP-3a Step 6+7 used --no-verify on 3-of-4 mirror
# pushes because re-running scripts/ci.sh --changed-only against an
# identical SHA was redundant. The hook now caches verified SHAs in
# this file and skips Layer 2 on cache hit. Local-only by design.
.lava-ci-evidence/.pre-push-verified-shas

# Timestamped scripts/ci.sh run-output dirs are local session telemetry,
# not committed evidence. The committed evidence files live at the
# top level of .lava-ci-evidence/ and in named subdirs (sp3a-*/, sp2-*/,
# bluff-hunt/, sixth-law-incidents/, Lava-Android-*/).
.lava-ci-evidence/2026-*/
# verify-all sweep attestations + helixqa wrapper runs are also operator
# session telemetry — recreated every invocation; never tracked.
.lava-ci-evidence/verify-all/
.lava-ci-evidence/helixqa-challenges/

# Build outputs at any depth (already covered for /build but nested
# modules generate their own build/ dirs)
**/build/
.env.*
.env.local

# === Firebase artifacts (added 2026-05-05) ===
# google-services.json contains the project's web API key — technically
# public per Firebase's threat model, but gitignored by project convention
# (see root CLAUDE.md §6.H: credentials never in tracked files).
app/google-services.json
**/google-services.json

# Firebase Web SDK config for Go API (firebase-web-config.json).
# Contains apiKey, authDomain, projectId, etc. — public-facing per
# Firebase's threat model but gitignored by convention.
lava-api-go/firebase-web-config.json

# Firebase Admin SDK service account key — HIGHLY SENSITIVE.
# This is a long-lived credential that grants server-side access
# to ALL Firebase services for the project. NEVER commit.
lava-api-go/firebase-admin-key.json
firebase-admin-key.json
**/firebase-admin-*.json

# Firebase debug log can leak request bodies including project IDs,
# OAuth tokens, etc. Local-only.
firebase-debug.log
**/firebase-debug.log

# Firebase App Distribution upload reports — local telemetry.
.firebase/
firebase-distribute-*.log

# Phase 11: build-time generated lava.auth.LavaAuthGenerated source
app/build/generated/lava-auth/

# Diagnostic logcat captures may contain credentials (UsernameChanged /
# PasswordChanged actions logged via OnboardingViewModel.logger.d).
# Per §6.H these MUST NOT be committed.
.lava-ci-evidence/**/post-mortem/
.lava-ci-evidence/**/logcat-*.txt

# === CodeGraph (added 2026-05-20) ===
# codegraph builds a local SQLite semantic knowledge graph at
# .codegraph/codegraph.db — a regenerable build artifact (`codegraph index`).
# Per CONST-053 (no versioned build artifacts) it MUST NOT be tracked.
# .codegraph/config.json IS tracked (committed project configuration).
.codegraph/codegraph.db
.codegraph/codegraph.db-shm
.codegraph/codegraph.db-wal
.codegraph/*.log
.codegraph/*.pid
.codegraph/*.lock
.codegraph/cache/
# Per-run codegraph verification-suite output is local session telemetry,
# regenerable by re-running scripts/verify-codegraph.sh. The suite scripts
# under tests/codegraph/ ARE the committed artifact.
.lava-ci-evidence/codegraph/

# LVA ticket system (tools/lava-tickets) — §11.4.95: tickets.db IS TRACKED, never ignored.
# Only the transient SQLite journal sidecars + the build output + the scratch driver are ignored.
docs/tickets/tickets.db-wal
docs/tickets/tickets.db-shm
docs/tickets/tickets.db-journal
tools/lava-tickets/bin/
tools/lava-tickets/_*.sh
tools/lava-tickets/digital.vasic.lava.tickets

# Chaos/stress (§11.4.85) regenerable run evidence — `go test -tags stress` regenerates.
# The curated proof lives at docs/chaos-stress/EVIDENCE-phase1.md (tracked).
lava-api-go/tests/stress/evidence/

# weasyprint per-run temp files (markdown-export PDF pipeline)
toPdfViaTempFile*

# markdown-export hermetic-test completion marker (scratch)
tests/check-markdown-export-sync/.fin

# Genymotion CLI downloaded tool binary (not evidence — fetched per run)
.lava-ci-evidence/genymotion/*/genymotion-cli

# §11.4.128 always-on device-recorder RAW output (logcat / screenrecord /
# screenshots / pids). Capture-and-store by default; only CURATED evidence is
# ever promoted out of this dir and committed. Raw is git-ignored + codegraph-
# excluded (.codegraph/config.json) so it never pollutes the index or history.
.lava-ci-evidence/device-recordings/
